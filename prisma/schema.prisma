generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id                 String              @id @default(uuid())
  name               String
  domain             String?
  theme              String?
  features           String?
  slackToken         String?
  slackTeamId        String?
  slackTeamName      String?
  createdAt          DateTime            @default(now())
  industry           String?
  licenseEnd         DateTime?
  licenseStart       DateTime?
  licenseStatus      String?             @default("Active")
  licensePlan        String?             @default("Enterprise")
  plan               String              @default("starter")
  tokensResetAt      DateTime            @default(now())
  tokensTotal        Int                 @default(500)
  tokensUsed         Int                 @default(0)
  approvalReqs       ApprovalRequest[]
  ApprovalRule       ApprovalRule[]
  bids               Bid[]
  categories         Category[]
  contracts          Contract[]
  events             Event[]
  formConfigurations FormConfiguration[]
  intakes            Intake[]
  jarvisMemories     JarvisMemory[]
  locations          Location[]
  products           Product[]
  purchaseOrders     PurchaseOrder[]
  teams              Team[]
  templates          Template[]
  users              User[]
  vendors            Vendor[]
  workflows          Workflow[]
}

model User {
  id             String        @id @default(uuid())
  name           String?
  email          String?       @unique
  phone          String?
  role           String?
  erpId          String?
  status         String        @default("Active")
  createdAt      DateTime      @default(now())
  organizationId String?
  password       String?
  onboardingData Json?
  impersonatedBy String?
  permissions    Json?
  organization   Organization? @relation(fields: [organizationId], references: [id])
}

model Team {
  id             String        @id @default(uuid())
  name           String?
  type           String?
  users          String?
  categories     String?
  locations      String?
  createdAt      DateTime      @default(now())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
}

model Location {
  id             String        @id @default(uuid())
  name           String?
  city           String?
  type           String?
  address        String?
  code           String?
  status         String        @default("Active")
  createdAt      DateTime      @default(now())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
}

model Category {
  id             String        @id @default(uuid())
  name           String?
  type           String?
  code           String?
  alias          String?
  origins        String?
  subCats        Int           @default(0)
  products       Int           @default(0)
  createdAt      DateTime      @default(now())
  organizationId String?
  customData     Json?
  organization   Organization? @relation(fields: [organizationId], references: [id])
}

model Product {
  id             String        @id @default(uuid())
  code           String        @unique @default(uuid())
  name           String?
  uom            String?
  category       String?
  subCategory    String?
  description    String?
  terms          String?
  articleCode    String?
  hsnCode        String?
  imageUrl       String?
  status         String        @default("Active")
  createdBy      String        @default("Admin")
  phone          String?
  createdAt      DateTime      @default(now())
  organizationId String?
  customData     Json?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

model Intake {
  id             String        @id @default(uuid())
  refId          String        @unique
  title          String?
  reqName        String?
  status         String        @default("Draft")
  type           String        @default("Standalone NFA")
  buyer          String?
  reqAt          String?
  updAt          String?
  source         String        @default("Manual")
  erpId          String?
  createdAt      DateTime      @default(now())
  quantity       Int           @default(1)
  organizationId String?
  customData     Json?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([refId])
}

model Event {
  id             String        @id @default(uuid())
  refId          String        @unique
  title          String?
  type           String?
  account        String?
  itemsCount     Int           @default(1)
  stages         String?
  participants   String?
  endTime        DateTime?
  createdAt      DateTime      @default(now())
  baseCurrency   String        @default("USD")
  feedbackMode   String        @default("Sealed")
  status         String        @default("Draft")
  organizationId String?
  sourcePrs      String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([refId])
}

model Vendor {
  id             String        @id @default(uuid())
  name           String?
  email          String?
  phone          String?
  type           String?
  vendorCode     String?
  companyCode    String?
  dealsIn        String?
  tradeLicense   String?
  taxId          String?
  city           String?
  tags           String?
  status         String        @default("Invited")
  createdAt      DateTime      @default(now())
  organizationId String?
  password       String?
  onboardingData Json?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

model PurchaseOrder {
  id             String        @id @default(uuid())
  poNumber       String        @unique
  title          String?
  status         String        @default("Draft")
  vendorId       String?
  eventId        String?
  total          Float         @default(0)
  details        String?
  source         String        @default("Manual")
  erpId          String?
  erpStatus      String        @default("Pending Sync")
  createdAt      DateTime      @default(now())
  organizationId String?
  asns           ASN[]
  grns           GRN[]
  invoices       Invoice[]
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([poNumber])
}

model Bid {
  id             String        @id @default(uuid())
  eventId        String
  vendorId       String
  vendorName     String?
  amount         Float
  templateData   String?
  status         String        @default("Submitted")
  createdAt      DateTime      @default(now())
  currency       String        @default("USD")
  exchangeRate   Float         @default(1.0)
  localAmount    Float?
  initialAmount  Float?
  organizationId String?
  chatHistory    String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@index([eventId])
  @@index([organizationId, createdAt(sort: Desc)])
}

model Contract {
  id             String        @id @default(uuid())
  title          String?
  status         String        @default("Draft")
  vendorId       String?
  vendorName     String?
  eventId        String?
  poId           String?
  content        String?
  total          Float         @default(0)
  clientSigned   Boolean       @default(false)
  vendorSigned   Boolean       @default(false)
  createdAt      DateTime      @default(now())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt(sort: Desc)])
}

model Template {
  id             String        @id @default(uuid())
  name           String
  fields         String
  createdAt      DateTime      @default(now())
  type           String        @default("RFQ")
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
}

model JarvisMemory {
  id             String        @id @default(uuid())
  entityType     String
  entityRef      String
  context        String
  createdAt      DateTime      @default(now())
  expiresAt      DateTime
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
}

model Workflow {
  id             String        @id @default(uuid())
  name           String
  category       String
  approvers      String
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
}

model ApprovalRequest {
  id             String        @id @default(uuid())
  eventId        String
  workflowId     String
  status         String        @default("Pending")
  currentStep    Int           @default(0)
  history        String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
}

model VerificationToken {
  id         String   @id @default(uuid())
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model LoginActivity {
  id         String   @id @default(uuid())
  identifier String
  ip         String?
  userAgent  String?
  city       String?
  success    Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([identifier])
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String?
  actorEmail     String
  actorName      String?
  action         String
  entityType     String?
  entityRef      String?
  details        String?
  ipAddress      String?
  userAgent      String?
  severity       String   @default("INFO")
  status         String   @default("SUCCESS")
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([actorEmail])
}

model ASN {
  id              String        @id @default(uuid())
  purchaseOrderId String
  asnNumber       String
  trackingId      String?
  carrier         String?
  status          String        @default("In Transit")
  estimatedDate   DateTime?
  details         String?
  createdAt       DateTime      @default(now())
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
}

model GRN {
  id              String        @id @default(uuid())
  purchaseOrderId String
  asnId           String?
  grnNumber       String
  receivedBy      String?
  location        String?
  status          String        @default("Received")
  details         String?
  createdAt       DateTime      @default(now())
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
}

model Invoice {
  id              String        @id @default(uuid())
  purchaseOrderId String
  invoiceNumber   String
  vendorId        String?
  totalAmount     Float         @default(0)
  taxAmount       Float         @default(0)
  dueDate         DateTime?
  status          String        @default("Pending")
  matchStatus     String        @default("Unmatched")
  details         String?
  createdAt       DateTime      @default(now())
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
}

model FormConfiguration {
  id             String       @id @default(uuid())
  organizationId String
  formName       String
  fieldName      String
  fieldLabel     String
  fieldType      String       @default("dropdown")
  options        String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, formName, fieldName])
}

model TokenLedger {
  id             String   @id @default(uuid())
  organizationId String
  action         String
  tokensConsumed Int
  actorEmail     String?
  entityRef      String?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, action])
}

model ContextDefinition {
  id             String   @id @default(uuid())
  organizationId String?
  name           String
  description    String?
  content        String
  version        String   @default("1.0.0")
  isActive       Boolean  @default(true)
  consumedBy     String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, name])
}

model ApprovalRule {
  id             String        @id @default(uuid())
  organizationId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  approvers      String
  department     String
  logic          String
  type           String
  value1         String
  value2         String?
  approvalType   String        @default("Quote Selection")
  flowName       String        @default("Default Flow")
  organization   Organization? @relation(fields: [organizationId], references: [id])
}

model CandidateResponse {
  id                  String    @id @default(uuid())
  email               String    @unique
  name                String?
  phone               String?
  education           String?
  experience          String?
  status              String    @default("PENDING")
  currentSectionIndex Int       @default(0)
  answers             String?
  logicalScore        Int?
  quantScore          Int?
  completedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}
